---
// The home page: a scroll-driven story (GSAP + Lenis, src/scripts/main.js) over plain, crawlable HTML.
// Copy that also feeds the structured data, the Markdown twin and llms-full.txt (the FAQ, the About
// text, contact details) comes from content/site.mjs; the rest of the markup is written here.
import { SITE, HOME } from '../../content/site.mjs';
import BaseHead from '../components/BaseHead.astro';
import Symbols from '../components/Symbols.astro';
import { wa, tel, YEAR, COMPANY_LINKS } from '../lib/text.mjs';
import { homeLd } from '../lib/schema.mjs';
import { lastmodOf } from '../lib/pages.mjs';
import '../styles/style.css';
import smokeUrl from '../assets/texture/about-smoke.webp?url';
import posterUrl from '../assets/video/about-poster.webp?url';
import loopMp4 from '../assets/video/about-loop.mp4?url';
import loopWebm from '../assets/video/about-loop.webm?url';
import founderImg from '../assets/team/team-1-sm.webp?url';
import team1 from '../assets/team/team-1.webp?url';
import team2 from '../assets/team/team-2.webp?url';
import team3 from '../assets/team/team-3.webp?url';
import team4 from '../assets/team/team-4.webp?url';

const head = {
  title: HOME.title,
  description: HOME.description,
  path: '/',
  ogImage: '/assets/og/home.jpg',
  ogAlt: 'Urobins: web and app development, CRM, cloud, SEO and digital marketing agency',
  jsonld: homeLd(await lastmodOf('/')),
  // the About smoke is the largest paint on phones, and only the CSS names it: fetch it with the HTML
  preloadImages: [smokeUrl],
};
---
<!doctype html>
<html lang="en">

<head>
<BaseHead {...head} />
  {/* without scripts there is no intro to play: drop the loader and let the page scroll */}
  <noscript>
    <style is:inline>
      .preloader { display: none; }
      body.is-loading { overflow: visible; }
    </style>
  </noscript>
</head>

<body class="is-loading">

  <a class="skip" href="#main">Skip to content</a>

  <Symbols />

  {/* A. Preloader: a close-up on a lamp pulls back; two giants rise and light the logo, which assembles
     as faint glass in the dark and takes its titanium, its glints and its shadows from the beams; then a
     dive into the light hands over */}
  <div class="preloader" id="preloader" aria-hidden="true">
    <canvas class="preloader__canvas"></canvas>
    <div class="preloader__logo">
      {/* the logo as faint glass. logo-light.js stacks copies of this artwork over it, each lit by one
        lamp (its titanium, then its glint; logo-light.js adds the metal's gradients, grain and bevel masks here) through a CSS mask drawn from that lamp's beam */}
      <svg class="ldr-glass" viewBox="0 0 430 120" width="430" height="120" aria-hidden="true">
        <defs>
          <path id="ldr-p0" d="M70 0h57l48 84h-58z" />
          <path id="ldr-p1" d="M150 136l58-105h58l-58 105z" />
          <path id="ldr-p2" d="M0 191l58-105h58l-58 105z" />
          <path id="ldr-p3" d="M224 217l58-105h58l-58 105z" />
          <path id="ldr-p4" d="M75 272l58-105h58l-58 105z" />
          <path id="ldr-p5" d="M165 219h58l47 84h-57z" />
          <linearGradient id="glassGrad" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0" stop-color="#fff" stop-opacity=".09" />
            <stop offset="1" stop-color="#fff" stop-opacity=".02" />
          </linearGradient>
          <clipPath id="wordClip">
            <rect x="140" y="0" width="0" height="120" />
          </clipPath>
        </defs>
        <g class="mark" transform="translate(0 5) scale(0.3636)">
          <use class="piece" href="#ldr-p0" /><use class="piece" href="#ldr-p1" /><use class="piece" href="#ldr-p2" />
          <use class="piece" href="#ldr-p3" /><use class="piece" href="#ldr-p4" /><use class="piece" href="#ldr-p5" />
        </g>
        <g class="word" clip-path="url(#wordClip)">
          <g transform="translate(150 27) scale(0.3064)"><use href="#logo-word" width="881" height="211" /></g>
        </g>
      </svg>
    </div>
    <div class="preloader__bar"><i></i></div>
    <div class="preloader__count"><span class="preloader__num">0</span>%</div>
  </div>

  {/* Navbar: one floating bar */}
  <header class="nav" id="nav">
    <div class="nav__bar">
      <i class="nav__pool" aria-hidden="true"><i></i></i>
      <a class="nav__logo" href="#top" aria-label="Urobins, back to top">
        {/* torch-lit logo (torch.js), one SVG so every layer shares one light space: the shadow it
          casts on the glass, the solid white logo, then, only while a torch is near, a cool shade
          masked away from the light, the white rim facing it and a white glint. Mark 21px and wordmark
          14px tall, 9px apart, as before. The symbols keep their own viewBox size and are scaled by
          transform: WebKit mis-sizes a resized <use> under a transform */}
        <svg class="nav__torch" viewBox="0 0 91.02 21" width="91" height="21" aria-hidden="true" focusable="false">
          <defs>
            <g id="nt-logo">
              <use href="#logo-mark" width="340" height="303" transform="scale(0.069307)" />
              <use href="#logo-word" width="881" height="211" transform="translate(32.564 3.5) scale(0.066351)" />
            </g>
            {/* light on the near side, the shade deepening away from it */}
            <radialGradient id="nt-far" gradientUnits="userSpaceOnUse" cx="0" cy="0" r="90">
              <stop offset="0" stop-color="#fff" stop-opacity="0.2" />
              <stop offset="0.45" stop-color="#fff" stop-opacity="0.6" />
              <stop offset="1" stop-color="#fff" stop-opacity="0.9" />
            </radialGradient>
            <linearGradient id="nt-band" gradientUnits="userSpaceOnUse" x1="0" y1="0" x2="16" y2="0">
              <stop offset="0" stop-color="#fff" stop-opacity="0" />
              <stop offset="0.5" stop-color="#fff" />
              <stop offset="1" stop-color="#fff" stop-opacity="0" />
            </linearGradient>
            <mask id="nt-cool" maskUnits="userSpaceOnUse" x="-12" y="-12" width="115" height="45">
              <rect x="-12" y="-12" width="115" height="45" fill="url(#nt-far)" />
            </mask>
            <mask id="nt-glint" maskUnits="userSpaceOnUse" x="-12" y="-12" width="115" height="45">
              <rect x="-12" y="-12" width="115" height="45" fill="url(#nt-band)" />
            </mask>
            {/* the rim: the logo less a copy of itself nudged away from the torch leaves its edges that
              face the light, which stay white over the shade like a bevel catching it */}
            <mask id="nt-rim" maskUnits="userSpaceOnUse" x="-12" y="-12" width="115" height="45">
              <rect x="-12" y="-12" width="115" height="45" fill="#fff" />
              <use href="#nt-logo" fill="#000" />
            </mask>
            {/* the shadow falls on the glass, never across the logo itself */}
            <mask id="nt-cut" maskUnits="userSpaceOnUse" x="-12" y="-12" width="115" height="45">
              <rect x="-12" y="-12" width="115" height="45" fill="#fff" />
              <use href="#nt-logo" fill="#000" />
            </mask>
          </defs>
          <g class="nav__shade" mask="url(#nt-cut)" opacity="0">
            <use href="#nt-logo" opacity="0.6" />
            <use href="#nt-logo" opacity="0.38" />
            <use href="#nt-logo" opacity="0.24" />
          </g>
          <use class="nav__rest" href="#nt-logo" />
          <g class="nav__lit" opacity="0">
            <use class="nav__cool" href="#nt-logo" mask="url(#nt-cool)" />
            <use class="nav__glint" href="#nt-logo" mask="url(#nt-rim)" />
            <use class="nav__glint" href="#nt-logo" mask="url(#nt-glint)" />
          </g>
        </svg>
      </a>
      <nav class="nav__menu" id="nav-menu" aria-label="Primary">
        <a href="#about">About</a>
        <a href="#capabilities">Services</a>
        <a href="#process">Process</a>
        <a href="#team">Team</a>
        <a href="/blog/">Blog</a>
        {/* phones: under the links on the sheet, the ways to reach us */}
        <div class="nav__reach">
          <p class="nav__avail"><i aria-hidden="true"></i>Taking on new projects</p>
          <a class="nav__mail" href={`mailto:${SITE.support}`}>{SITE.support}</a>
          <div class="nav__reach-row">
            <a href={wa("Hi Urobins, I'd like to discuss a project.")} target="_blank" rel="noopener"><svg aria-hidden="true">
                <use href="#i-whatsapp" />
              </svg>WhatsApp</a>
            <a href={tel}><svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1A17 17 0 0 1 3 4c0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.3.2 2.5.6 3.6.1.3 0 .7-.2 1z" />
              </svg>Call&nbsp;us</a>
          </div>
        </div>
      </nav>
      <div class="nav__right">
        {/* phones: chat straight away, beside the quote button */}
        <a class="nav__wa" href={wa("Hi Urobins, I'd like to discuss a project.")}
          target="_blank" rel="noopener" aria-label="Chat with us on WhatsApp"><svg aria-hidden="true">
            <use href="#i-whatsapp" />
          </svg></a>
        <a class="nav__cta pill pill--brand" href={wa("Hi Urobins, I'd like a quote for a project.")} target="_blank" rel="noopener"><span class="nav__cta-full">Contact</span><span
            class="nav__cta-quote">Get a quote</span> <svg class="arr" aria-hidden="true">
            <use href="#i-arrow" />
          </svg></a>
        <button class="nav__toggle" type="button" id="nav-toggle" aria-expanded="false" aria-controls="nav-menu"
          aria-label="Menu"><span></span><span></span></button>
      </div>
    </div>
  </header>

  <main id="main">

    {/* B. Hero + C. Transition 1 (stepped bars, drawn in WebGL) */}
    <section class="hero" id="top" aria-label="Introduction">
      <div class="hero__pin">
        <canvas class="hero__gl" aria-hidden="true"></canvas>
        <div class="hero__layer">
          <div class="hero__content">
            <h1 class="hero__eyebrow eyebrow"><span class="line"><span class="line__in">Urobins · Web &amp; App
                  Development, CRM, SEO &amp; Digital Marketing Agency</span></span></h1>
            <p class="hero__title">
              <span class="line"><span class="line__in">Scaling <em>Brands</em></span></span>
              <span class="line"><span class="line__in"><em>Digital</em> Technology
                  Agency</span></span>
            </p>
            <p class="hero__sub">We build custom websites, mobile applications, CRM workflows, and secure cloud
              infrastructure, paired with strategic SEO and performance marketing to scale your brand.</p>
            <div class="hero__actions">
              <a class="pill pill--brand" href={wa("Hi Urobins, I'd like to start a project.")} target="_blank" rel="noopener" data-magnet>Start a project <svg class="arr"
                  aria-hidden="true">
                  <use href="#i-arrow" />
                </svg></a>
              <a class="pill pill--glass" href="#capabilities" data-magnet>Our services</a>
            </div>
          </div>
          <div class="hero__scroll" aria-hidden="true"><span>Scroll</span><i></i></div>
        </div>
      </div>
    </section>

    {/* D. About (one sticky stage; the video pill opens into the Impact chapter) */}
    <section class="story" id="about" aria-label="About Urobins">
      <div class="story__pin">

        <div class="about">
          <div class="about__smoke" aria-hidden="true"></div>
          <svg class="about__line" viewBox="0 0 1440 900" preserveAspectRatio="none" aria-hidden="true">
            <path
              d="M 277 162 L 304 189 L 296 181 C 293 178, 286 169, 281 163 C 277 157, 276 152, 271 145 C 267 138, 260 127, 254 120 C 249 112, 241 103, 238 100 C 242 105, 256 123, 265 132 C 273 142, 280 146, 290 155 C 299 165, 310 177, 321 190 C 332 202, 341 212, 356 230 C 371 248, 392 272, 413 299 C 434 326, 465 368, 481 391 C 497 414, 501 423, 507 437 C 513 452, 516 464, 517 478 C 519 491, 517 502, 515 518 C 513 534, 509 559, 507 575 C 505 592, 501 604, 502 616 C 502 627, 505 637, 509 643 C 513 649, 514 653, 524 651 C 535 650, 542 646, 571 633 C 600 620, 655 595, 699 575 C 744 556, 801 531, 839 518 C 877 505, 911 498, 930 496 C 949 494, 951 500, 956 504 C 961 508, 959 514, 958 520 C 957 526, 956 526, 948 541 C 939 556, 920 591, 909 610 C 898 629, 893 639, 882 656 C 872 673, 862 689, 847 714 C 832 738, 806 781, 793 806 C 781 830, 774 849, 771 861 C 768 872, 771 874, 776 875 C 780 875, 785 875, 798 863 C 810 852, 831 831, 850 806 C 870 781, 897 740, 914 714 C 932 687, 944 668, 958 645 C 972 621, 984 600, 997 575 C 1011 551, 1028 518, 1040 495 C 1051 472, 1060 455, 1068 437 C 1075 420, 1081 407, 1086 391 C 1091 376, 1095 360, 1098 345 C 1100 330, 1103 312, 1103 302 C 1102 291, 1099 284, 1094 281 C 1090 278, 1089 279, 1076 282 C 1062 285, 1037 291, 1014 302 C 991 312, 963 331, 936 345 C 909 360, 874 380, 850 389 C 827 398, 815 398, 797 398 C 778 399, 760 396, 740 391 C 719 387, 692 378, 672 371 C 653 363, 638 354, 625 345 C 612 336, 601 326, 595 316 C 588 307, 587 297, 587 288 C 586 278, 593 265, 594 260" />
          </svg>

          <h2 class="about__title" aria-label="A Clear Digital Path To Scale Fast">
            <span class="aline" aria-hidden="true"><span class="split">A Clear</span></span>
            <span class="aline aline--mid" aria-hidden="true">
              <span class="split">Digital</span>
              <span class="about__video">
                <video poster={posterUrl} muted loop playsinline preload="none">
                  <source src={loopMp4} type="video/mp4; codecs=avc1.64001F">
                  <source src={loopWebm} type="video/webm; codecs=vp9">
                </video>
              </span>
              <span class="split">Path</span>
            </span>
            <span class="aline" aria-hidden="true"><em class="split">To Scale Fast</em></span>
          </h2>

          <div class="about__grid">
            <div class="about__col">
              <p class="eyebrow">About us</p>
            </div>
            <div class="about__col about__col--mid">
              <p class="eyebrow">Promises</p>
              <div class="founder">
                <img class="founder__img" src={founderImg} alt="" width="48" height="48">
                <div class="founder__text">
                  <p class="founder__name">Nikhil Chauhan</p>
                  <p class="founder__role">CEO &amp; CTO</p>
                </div>
              </div>
            </div>
            <div class="about__col about__copy">
              {HOME.about.map((p) => <p>{p}</p>)}
            </div>
          </div>
        </div>

        {/* the pill grows into this panel: the header of the Impact chapter */}
        <div class="portal">
          <div class="portal__bg" aria-hidden="true"></div>
          <div class="portal__inner">
            <svg class="portal__mark" viewBox="0 0 340 303" aria-hidden="true">
              <use href="#logo-mark" />
            </svg>
            <div class="portal__head section__head">
              <p class="eyebrow">Our commitments</p>
              <h2 class="section__title">
                <span class="line"><span class="line__in">Numbers we</span></span>
                <span class="line"><span class="line__in"><em>stand behind</em></span></span>
              </h2>
              <p class="section__lede">No inflated case numbers. These are the standards we hold ourselves to on every
                project, written down before we start.</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    {/* E. Impact: bento of commitments (slides up over the open portal) */}
    <section class="metrics" id="impact" aria-label="Our commitments">
      <div class="bento">
        <article class="card card--hero">
          <h3 class="tag"><i class="tag__ic"><svg class="ic-bolt" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M13 2 4 14h7l-1 8 9-12h-7z" />
              </svg></i>Engineering-led delivery</h3>
          <div class="card__foot">
            <p class="card__big"><span class="count" data-count="45" data-suffix=" days">45 days</span></p>
            <div class="card__side">
              <p class="card__text">from kickoff to a production-ready MVP for a typical product, with a working build
                to review every two weeks along the way.</p>
              <a class="pill pill--white" href={wa("Hi Urobins, I'd like to start a project.")} target="_blank" rel="noopener" data-magnet>Start a project <svg class="arr"
                  aria-hidden="true">
                  <use href="#i-arrow" />
                </svg></a>
            </div>
          </div>
        </article>
        <article class="card card--bars">
          <h3 class="tag"><i class="tag__ic"><svg class="ic-ring" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M12 4a8 8 0 1 1-5.7 2.3" />
              </svg><svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="M12 8v4l3 2" />
              </svg></i>Cloud uptime target</h3>
          <p class="card__big"><span class="count" data-count="99.9" data-decimals="1" data-suffix="%">99.9%</span></p>
          <p class="card__text">uptime target for every environment we run, with monitoring, backups, and patching in
            place before the first user signs in.</p>
          <div class="card__bars" aria-hidden="true"></div>
        </article>
        <article class="card card--third">
          <h3 class="tag"><i class="tag__ic"><svg class="ic-rocket" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M12 15c-2.6-2.6-2.6-7.6 0-11.2 2.6 3.6 2.6 8.6 0 11.2z" />
                <path d="M9.6 12.4 7 14l1 3 2.2-1.6M14.4 12.4 17 14l-1 3-2.2-1.6M12 15v4.5" />
              </svg></i>Release cadence</h3>
          <p class="card__big"><span class="count" data-count="2" data-suffix=" weeks" data-static>2 weeks</span></p>
          <p class="card__text">between releases you can click through yourself. Progress is something you use, not
            something we present.</p>
        </article>
        <article class="card card--third">
          <h3 class="tag"><i class="tag__ic"><svg viewBox="0 0 24 24" aria-hidden="true">
                <path class="ic-chart" d="M4 17l5-6 4 3 7-8" />
                <path d="M15 6h5v5" />
              </svg></i>Response time</h3>
          <p class="card__big"><span class="count" data-count="24" data-suffix="h">24h</span></p>
          <p class="card__text">to answer every inquiry with next steps and a rough timeline. One business day, every
            time.</p>
        </article>
        <article class="card card--third">
          <h3 class="tag"><i class="tag__ic"><svg class="ic-gear" viewBox="0 0 24 24" aria-hidden="true">
                <circle cx="12" cy="12" r="3" />
                <path d="M12 2v3M12 19v3M2 12h3M19 12h3M4.9 4.9l2.1 2.1M17 17l2.1 2.1M4.9 19.1 7 17M17 7l2.1-2.1" />
              </svg></i>In-house team</h3>
          <p class="card__big"><span class="count" data-count="100" data-suffix="%">100%</span></p>
          <p class="card__text">of design and engineering is done by our own team. Nothing is outsourced, so nothing
            gets lost in a hand-off.</p>
        </article>
      </div>
      {/* phones: the cards read as a ledger, with one CTA after the last row */}
      <div class="metrics__cta">
        <a class="pill pill--white" href={wa("Hi Urobins, I'd like to start a project.")} target="_blank" rel="noopener">Start a project <svg class="arr" aria-hidden="true">
            <use href="#i-arrow" />
          </svg></a>
      </div>
    </section>

    {/* F. How we work: a pinned, scrolling column of stages beside a tilted wall of project mockups */}
    <section class="process" id="process" aria-label="How we work">
      <div class="process__pin">
        <div class="process__left">
          <p class="eyebrow process__eyebrow">How we work</p>
          {/* phones only: the stages read as a timeline under a heading */}
          <h2 class="process__title">
            <span class="line"><span class="line__in">Four steps,</span></span>
            <span class="line"><span class="line__in"><em>one team</em></span></span>
          </h2>
          <div class="process__scroller">
            <article class="stage">
              <p class="stage__num">01 / 04</p>
              <h3 class="stage__title">Discover</h3>
              <p class="stage__text">We start with a technical audit of your product, users, and systems, then design
                the architecture and a roadmap you can hold us to.</p>
              <p class="stage__stat"><b>A fixed-scope first sprint.</b> You see working software inside the first two
                weeks, not a deck.</p>
            </article>
            <article class="stage">
              <p class="stage__num">02 / 04</p>
              <h3 class="stage__title">Build</h3>
              <p class="stage__text">Design and engineering move together: UX, front end, back end, and QA, shipped in
                two-week releases you can click through.</p>
              <p class="stage__stat"><b>Production-ready in about 45 days</b> for a typical MVP, on a codebase built to
                keep growing.</p>
            </article>
            <article class="stage">
              <p class="stage__num">03 / 04</p>
              <h3 class="stage__title">Launch</h3>
              <p class="stage__text">Cloud infrastructure, monitoring, backups, and a go-live checklist, so launch day
                is the quietest day of the project.</p>
              <p class="stage__stat"><b>Monitoring, backups and alerts</b> are live before the first user signs in.</p>
            </article>
            <article class="stage">
              <p class="stage__num">04 / 04</p>
              <h3 class="stage__title">Scale</h3>
              <p class="stage__text">SEO, performance marketing, and CRM automation turn a launched product into a
                growing business, reported against revenue.</p>
              <p class="stage__stat"><b>Reporting tied to revenue,</b> not vanity metrics: rankings, traffic,
                conversions and spend in one dashboard.</p>
            </article>
          </div>
          <div class="process__rail" aria-hidden="true">
            <span class="process__track"><i class="process__fill"></i></span>
            <span class="process__dots"><i class="is-on"></i><i></i><i></i><i></i></span>
          </div>
        </div>
        <div class="process__right" aria-hidden="true">
          <div class="wall">
            <div class="wall__col wall__col--a">
              <div class="mock" data-kind="dash" style="--acc:#4b48ff"><span class="mock__label">Fintech
                  dashboard</span></div>
              <div class="mock" data-kind="phone" style="--acc:#38d996"><span class="mock__label">Healthcare app</span>
              </div>
              <div class="mock" data-kind="table" style="--acc:#f6c54a"><span class="mock__label">Logistics CRM</span>
              </div>
              <div class="mock" data-kind="site" style="--acc:#3fd1ff"><span class="mock__label">Insurance portal</span>
              </div>
              <div class="mock" data-kind="phone" style="--acc:#ff6a3d"><span class="mock__label">Travel booking
                  app</span></div>
            </div>
            <div class="wall__col wall__col--b">
              <div class="mock" data-kind="site" style="--acc:#7c5cff"><span class="mock__label">SaaS website</span>
              </div>
              <div class="mock" data-kind="shop" style="--acc:#ff6a3d"><span class="mock__label">E-commerce app</span>
              </div>
              <div class="mock" data-kind="crm" style="--acc:#3fd1ff"><span class="mock__label">Real-estate
                  portal</span></div>
              <div class="mock" data-kind="dash" style="--acc:#38d996"><span class="mock__label">Analytics
                  platform</span></div>
              <div class="mock" data-kind="shop" style="--acc:#f6c54a"><span class="mock__label">Restaurant
                  ordering</span></div>
            </div>
          </div>
        </div>
      </div>
    </section>

    {/* G. What we build: capability cards with vector scenes */}
    <section class="caps" id="capabilities" aria-label="What we build">
      <div class="section__head">
        <p class="eyebrow">What we build</p>
        <h2 class="section__title rv">
          <span class="line"><span class="line__in">Everything your product needs,</span></span>
          <span class="line"><span class="line__in"><em>under one roof</em></span></span>
        </h2>
        <p class="section__lede rv-text">One accountable team from the first wireframe to the last deployment, so
          nothing gets lost between agencies.</p>
      </div>
      <div class="caps__grid">
        <article class="cap" data-cap="apps">
          <div class="cap__body">
            <p class="tag"><i class="tag__ic"><svg viewBox="0 0 24 24" aria-hidden="true">
                  <rect x="7" y="2.5" width="10" height="19" rx="2.5" />
                  <path d="M11 18h2" />
                </svg></i>Web &amp; Mobile</p>
            <h3 class="cap__title">Custom Web &amp; <em>Mobile Apps</em></h3>
            <p class="cap__text">High-performance web platforms and native mobile experiences, engineered for speed and
              built to grow with your users.</p>
            <ul class="cap__more">
              <li><a href="/web-development/">Web development <svg class="arr" aria-hidden="true"><use href="#i-arrow" /></svg></a></li>
              <li><a href="/mobile-app-development/">App development <svg class="arr" aria-hidden="true"><use href="#i-arrow" /></svg></a></li>
            </ul>
          </div>
          <div class="cap__visual" aria-hidden="true"></div>
        </article>
        <article class="cap" data-cap="dev">
          <div class="cap__body">
            <p class="tag"><i class="tag__ic"><svg viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M8 8 4 12l4 4M16 8l4 4-4 4M13.5 5l-3 14" />
                </svg></i>Engineering</p>
            <h3 class="cap__title">Development &amp; <em>Cloud</em></h3>
            <p class="cap__text">Modern stacks, secure cloud architecture, CI/CD, and DevOps, so every release is fast,
              repeatable, and safe.</p>
            <ul class="cap__more">
              <li><a href="/cloud-devops/">Cloud &amp; DevOps <svg class="arr" aria-hidden="true"><use href="#i-arrow" /></svg></a></li>
            </ul>
          </div>
          <div class="cap__visual" aria-hidden="true"></div>
        </article>
        <article class="cap" data-cap="crm">
          <div class="cap__body">
            <p class="tag"><i class="tag__ic"><svg viewBox="0 0 24 24" aria-hidden="true">
                  <circle cx="5" cy="12" r="2.5" />
                  <circle cx="19" cy="6" r="2.5" />
                  <circle cx="19" cy="18" r="2.5" />
                  <path d="M7.3 11 16.7 7M7.3 13l9.4 4" />
                </svg></i>Automation</p>
            <h3 class="cap__title">CRM Workflows &amp; <em>Automation</em></h3>
            <p class="cap__text">Custom pipelines and integrations that connect sales, support, and billing into one
              reliable flow your team actually uses.</p>
            <ul class="cap__more">
              <li><a href="/crm-development/">CRM development <svg class="arr" aria-hidden="true"><use href="#i-arrow" /></svg></a></li>
            </ul>
          </div>
          <div class="cap__visual" aria-hidden="true"></div>
        </article>
        <article class="cap" data-cap="seo">
          <div class="cap__body">
            <p class="tag"><i class="tag__ic"><svg viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M4 17l5-6 4 3 7-8M15 6h5v5" />
                </svg></i>Growth</p>
            <h3 class="cap__title">SEO &amp; Performance <em>Marketing</em></h3>
            <p class="cap__text">Technical SEO, content that ranks, and paid acquisition measured against revenue rather
              than vanity metrics.</p>
            <ul class="cap__more">
              <li><a href="/seo-services/">SEO services <svg class="arr" aria-hidden="true"><use href="#i-arrow" /></svg></a></li>
              <li><a href="/digital-marketing/">Digital marketing <svg class="arr" aria-hidden="true"><use href="#i-arrow" /></svg></a></li>
            </ul>
          </div>
          <div class="cap__visual" aria-hidden="true"></div>
        </article>
      </div>
    </section>

    {/* H. Team */}
    <section class="team" id="team" aria-label="Meet the team">
      <div class="section__head">
        <p class="eyebrow">The team</p>
        <h2 class="section__title rv">
          <span class="line"><span class="line__in">Meet the</span></span>
          <span class="line"><span class="line__in"><em>team</em></span></span>
        </h2>
        <p class="section__lede rv-text">A small senior team that designs, builds, and grows products together, with no
          hand-offs between agencies.</p>
      </div>
      <div class="team__grid">
        <article class="member">
          <div class="member__img"><img src={team1} alt="Portrait of Nikhil Chauhan" loading="lazy"
              width="800" height="1000"></div>
          <div class="member__meta">
            <h3 class="member__name">Nikhil Chauhan</h3>
            <p class="member__role">CEO &amp; CTO</p>
          </div>
          <p class="member__focus">Technology strategy, product vision and executive leadership</p>
        </article>
        <article class="member">
          <div class="member__img"><img src={team2} alt="Portrait of Vansh Sharma" loading="lazy"
              width="800" height="1000"></div>
          <div class="member__meta">
            <h3 class="member__name">Vansh Sharma</h3>
            <p class="member__role">Head of Engineering</p>
          </div>
          <p class="member__focus">System architecture, engineering execution and technical delivery</p>
        </article>
        <article class="member">
          <div class="member__img"><img src={team3} alt="Portrait of Priya Raman" loading="lazy"
              width="800" height="1000"></div>
          <div class="member__meta">
            <h3 class="member__name">Priya Raman</h3>
            <p class="member__role">Product Designer</p>
          </div>
          <p class="member__focus">UX research, interfaces and design systems</p>
        </article>
        <article class="member">
          <div class="member__img"><img src={team4} alt="Portrait of Rohan Verma" loading="lazy"
              width="800" height="1000"></div>
          <div class="member__meta">
            <h3 class="member__name">Rohan Verma</h3>
            <p class="member__role">Cloud &amp; DevOps Lead</p>
          </div>
          <p class="member__focus">AWS, Kubernetes, CI/CD and security</p>
        </article>
      </div>
    </section>

  </main>

  {/* Contact, FAQ, services: the page's footer (contentinfo), outside <main> */}
  <footer class="contact" id="contact">
    <div class="marquee" aria-hidden="true">
      <div class="marquee__track">
        <span>Websites</span><i></i><span>Mobile apps</span><i></i><span>CRM workflows</span><i></i><span>Cloud
          infrastructure</span><i></i><span>Technical SEO</span><i></i><span>Performance marketing</span><i></i>
        <span>Websites</span><i></i><span>Mobile apps</span><i></i><span>CRM workflows</span><i></i><span>Cloud
          infrastructure</span><i></i><span>Technical SEO</span><i></i><span>Performance marketing</span><i></i>
      </div>
    </div>
    <div class="contact__cta">
      <h2 class="contact__title rv">
        <span class="line"><span class="line__in">Have a product</span></span>
        <span class="line"><span class="line__in"><em>to scale?</em></span></span>
      </h2>
      <div class="contact__actions">
        <p class="rv-text">Tell us what you are building. We reply within one business day with next steps and a rough
          timeline.</p>
        <a class="pill pill--brand pill--lg" href={wa("Hi Urobins, I'd like to start a project.")} target="_blank" rel="noopener" data-magnet>Start a project <svg
            class="arr" aria-hidden="true">
            <use href="#i-arrow" />
          </svg></a>
        <dl class="contact__list">
          <div>
            <dt>General inquiries</dt>
            <dd><a href={`mailto:${SITE.email}`}>{SITE.email}</a></dd>
          </div>
          <div>
            <dt>Client &amp; technical support</dt>
            <dd><a href={`mailto:${SITE.support}`}>{SITE.support}</a></dd>
          </div>
          <div>
            <dt>Phone / WhatsApp</dt>
            <dd><a href={tel} set:html={SITE.phone.replace(/ /g, '&nbsp;')} /> &middot; <a href={SITE.whatsapp}
                target="_blank" rel="noopener">WhatsApp</a></dd>
          </div>
        </dl>
      </div>
    </div>
    <div class="contact__cols">
      <div class="faq" id="faq">
        <h2 class="eyebrow">FAQ</h2>
        {HOME.faqs.map(([q, a, html]) => (
          <details>
            <summary>{q}</summary>
            {html ? <p set:html={html} /> : <p>{a}</p>}
          </details>
        ))}
      </div>
      <nav class="resources" aria-labelledby="footer-services">
        <h2 class="eyebrow" id="footer-services">Services</h2>
        <ul>
          <li><a href="/web-development/">Web development <svg class="arr" aria-hidden="true">
                <use href="#i-arrow" />
              </svg></a></li>
          <li><a href="/mobile-app-development/">Mobile app development <svg class="arr" aria-hidden="true">
                <use href="#i-arrow" />
              </svg></a></li>
          <li><a href="/crm-development/">CRM development <svg class="arr" aria-hidden="true">
                <use href="#i-arrow" />
              </svg></a></li>
          <li><a href="/seo-services/">SEO services <svg class="arr" aria-hidden="true">
                <use href="#i-arrow" />
              </svg></a></li>
          <li><a href="/digital-marketing/">Digital marketing <svg class="arr" aria-hidden="true">
                <use href="#i-arrow" />
              </svg></a></li>
          <li><a href="/cloud-devops/">Cloud &amp; DevOps <svg class="arr" aria-hidden="true">
                <use href="#i-arrow" />
              </svg></a></li>
        </ul>
        <h2 class="eyebrow resources__sub" id="footer-company">Company</h2>
        <ul aria-labelledby="footer-company">
          {COMPANY_LINKS.map(([n, h]) => (
            <li><a href={h}>{n} <svg class="arr" aria-hidden="true"><use href="#i-arrow" /></svg></a></li>
          ))}
        </ul>
      </nav>
    </div>
    <div class="contact__base">
      <p class="contact__mark" role="img" aria-label="Urobins">
        <svg class="contact__mark-m" viewBox="0 0 340 303" aria-hidden="true">
          <use href="#logo-mark" />
        </svg>
        <svg class="contact__mark-w" viewBox="0 0 881 211" aria-hidden="true">
          <use href="#logo-word" />
        </svg>
      </p>
      <div class="contact__meta">
        <ul class="social" aria-label="Urobins on social media">
          {SITE.social.map(([n, h, ic]) => (
            <li><a href={h} target="_blank" rel="noopener me" aria-label={`Urobins on ${n}`} title={n}><svg aria-hidden="true"><use href={`#${ic}`} /></svg></a></li>
          ))}
        </ul>
        <p>&copy; {YEAR} Urobins. Engineering and growth for ambitious brands.</p>
      </div>
    </div>
  </footer>

  <aside aria-label="Book a call">
    <a class="book" id="book"
      href={wa("Hi Urobins, I'd like to book a call.")} target="_blank"
      rel="noopener"><svg class="book__ic" viewBox="0 0 24 24" aria-hidden="true">
        <path d="M12 3.5a8.5 8.5 0 0 0-7.4 12.7L3.5 20.5l4.4-1.1A8.5 8.5 0 1 0 12 3.5Z" />
        <path d="M9.2 8.6c.3-.4.8-.4 1 0l.7 1.5c.1.3 0 .6-.2.8l-.5.5c.5 1.1 1.4 2 2.5 2.5l.5-.5c.2-.2.5-.3.8-.2l1.5.7c.4.2.4.7 0 1-1.2 1.1-2.8.9-4.6-.6-1.6-1.4-2.6-3.1-2.4-4.4.1-.5.4-1 .7-1.3Z" />
      </svg><span class="book__label">Book a call</span> <svg class="arr" aria-hidden="true">
        <use href="#i-arrow" />
      </svg></a>
  </aside>

  <script>
    import '../scripts/main.js';
  </script>
</body>

</html>
