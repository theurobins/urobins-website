---
// /blog/: every post in content/blog/. The featured post (or the newest) large on top, then a filterable
// grid by category (page.js shows and hides cards; without JavaScript every post simply shows)
import { SITE, BLOG } from '../../../content/site.mjs';
import { CATEGORIES } from '../../content.config.mjs';
import PageShell from '../../components/PageShell.astro';
import Glass from '../../components/Glass.astro';
import PostCard from '../../components/PostCard.astro';
import { lines } from '../../lib/text.mjs';
import { blogLd } from '../../lib/schema.mjs';
import { getPosts, lastmodOf } from '../../lib/pages.mjs';
import avatar from '../../assets/team/team-1-sm.webp?url';

const posts = await getPosts();
const featured = posts.find((p) => p.data.featured) ?? posts[0];
const rest = posts.filter((p) => p !== featured);
const counts = CATEGORIES.map((c) => [c, posts.filter((p) => p.data.category === c).length]).filter(([, n]) => n > 0);
const waText = "Hi Urobins, I read your blog and I'd like to discuss a project.";
const head = {
  title: BLOG.title,
  description: BLOG.description,
  path: '/blog/',
  ogImage: '/assets/og/home.jpg',
  ogAlt: 'The Urobins blog',
  jsonld: blogLd(posts, await lastmodOf('/blog/')),
};
---
<PageShell head={head} bodyClass="page" waText={waText} footer={{ ctaHtml: ['Rather we', '<em>did it for you?</em>'], waText, current: '/blog/' }}>

    <section class="page-hero page-hero--short" aria-labelledby="page-title">
      <Glass />
      <div class="page-hero__in">
        <nav class="crumbs" aria-label="Breadcrumb">
          <ol>
            <li><a href="/">Home</a></li>
            <li aria-current="page">Blog</li>
          </ol>
        </nav>
        <p class="eyebrow page-hero__eyebrow">{BLOG.eyebrow} · {posts.length} guides</p>
        <h1 class="page-hero__title" id="page-title" set:html={lines(BLOG.h1Html)} />
        <div class="page-hero__foot">
          <p class="page-hero__lede">{BLOG.lede}</p>
        </div>
      </div>
    </section>

    <section class="sp-sec blog-top" aria-label="Featured post">
      <ul class="pgrid pgrid--one">
        <PostCard p={featured} big />
      </ul>
    </section>

    <section class="sp-sec blog-all" aria-labelledby="all-title">
      <div class="blog-all__head">
        <h2 class="eyebrow" id="all-title">All guides</h2>
        <div class="chips" role="group" aria-label="Filter by topic" id="blog-filter">
          <button type="button" class="chip" aria-pressed="true" data-filter="">All <span>{posts.length}</span></button>
          {counts.map(([c, n]) => <button type="button" class="chip" aria-pressed="false" data-filter={c}>{c} <span>{n}</span></button>)}
        </div>
      </div>
      <ul class="pgrid" id="blog-grid">
        {rest.map((p) => <PostCard p={p} />)}
      </ul>
      <p class="posts__by"><img class="byline__img" src={avatar} alt="" width="36" height="36">Written by <a href="/about/">{SITE.founder.name}</a>, {SITE.founder.role} at Urobins.</p>
    </section>

</PageShell>
