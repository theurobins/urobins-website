{
  "name": "urobins-site",
  "version": "1.0.0",
  "private": true,
  "description": "Urobins agency website: scroll-driven home page (GSAP + Lenis) and static service pages",
  "scripts": {
    "start": "npm run serve",
    "build": "npm run build:pages && npm run build:js && npm run stamp",
    "build:pages": "node scripts/build-pages.mjs",
    "build:js": "esbuild src/main.js --bundle --minify --format=iife --target=es2019 --outfile=js/app.js && esbuild src/page.js --bundle --minify --format=iife --target=es2019 --outfile=js/page.js",
    "stamp": "node scripts/stamp-assets.mjs",
    "watch": "esbuild src/main.js --bundle --format=iife --target=es2019 --outfile=js/app.js --watch",
    "serve": "npx http-server . -p 8080 -c-1"
  },
  "dependencies": {
    "gsap": "3.13.0",
    "lenis": "1.3.23"
  },
  "devDependencies": {
    "esbuild": "0.25.10"
  }
}
