{
  "name": "urobins-site",
  "version": "1.0.0",
  "private": true,
  "description": "Urobins agency website: scroll-driven, GSAP + Lenis + Three.js",
  "scripts": {
    "build": "npm run build:app && npm run build:3d",
    "build:app": "esbuild src/main.js --bundle --minify --format=iife --target=es2019 --outfile=js/app.js",
    "build:3d": "esbuild src/sculpture.js --bundle --minify --format=iife --global-name=UrobinsSculpture --target=es2019 --outfile=js/sculpture.js",
    "watch": "esbuild src/main.js --bundle --format=iife --target=es2019 --outfile=js/app.js --watch",
    "serve": "npx http-server . -p 8080 -c-1"
  },
  "dependencies": {
    "gsap": "3.13.0",
    "lenis": "1.3.23",
    "three": "0.170.0"
  },
  "devDependencies": {
    "esbuild": "0.25.10"
  }
}
